#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

// baseURL dideteksi otomatis dari host yang dipakai (localhost / IP LAN / nama host)
// supaya CSS, form, dan redirect tetap benar saat diakses dari HP atau PC lain.
// Isi baris di bawah HANYA bila ingin memaksa satu URL (mis. di balik reverse proxy).
// app.baseURL = 'http://localhost/SIMPENA/public/'
app.forceGlobalSecureRequests = false
app.CSPEnabled = false

#--------------------------------------------------------------------
# DATABASE
#--------------------------------------------------------------------

database.default.hostname = localhost
database.default.database = simpena
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix = 
database.default.port = 3306

#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

# (biarkan kosong dulu)

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
session.savePath = 'C:/wamp64/www/SIMPENA/writable/session'

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

logger.threshold = 4

#--------------------------------------------------------------------
# SECURITY (CSRF) - yang sudah Anda tambahkan
#--------------------------------------------------------------------
security.csrfProtection = 'session'
security.tokenRandomize =
security.tokenName =
security.headerName = 'X-CSRF-TOKEN'
security.cookieName = 'csrf_cookie_name'
security.expires = 7200
# regenerate = false: token TIDAK diganti setiap request, supaya beberapa
# request AJAX dari satu halaman (simpan, hapus, dst) tidak ditolak 403.
security.regenerate = false
